# EditorConfig —— 让不同编辑器/平台保持一致的代码风格
# 与 .gitattributes 配合：文件落到磁盘上一律 LF + UTF-8
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml,json}]
indent_size = 2

[*.{md,markdown}]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
